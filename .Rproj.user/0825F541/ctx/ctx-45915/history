# Split facet wrap into bigger and smaller genres to make heat map more clear for smaller genres
Tidy_Ratings %>%
select(movie_ID, your_rating, IMDb_Rating_Rnd) %>%
left_join(Genre_long, by = "movie_ID") %>%
group_by(genre) %>%
filter(n() > 500) %>%
dplyr::count(IMDb_Rating_Rnd, your_rating, name = "n") %>%
ggplot(aes(IMDb_Rating_Rnd, your_rating, fill = n)) +
geom_tile(color = "white") +
scale_fill_viridis_c(name = "Count", option = "C") + # could look at better colours range
scale_x_continuous("IMDb rating (rounded)", breaks = 1:10) +
scale_y_continuous("My rating", breaks = 2:10, limits = c(1, 11)) +
facet_wrap(~genre) +
labs(title = "Heatmap of My Ratings vs IMDb Rating") +
theme(legend.position = "right")
Tidy_Ratings %>%
select(movie_ID, your_rating, IMDb_Rating_Rnd) %>%
left_join(Genre_long, by = "movie_ID") %>%
group_by(genre) %>%
filter(n() > 49, n() < 500) %>%
dplyr::count(IMDb_Rating_Rnd, your_rating, name = "n") %>%
ggplot(aes(IMDb_Rating_Rnd, your_rating, fill = n)) +
geom_tile(color = "white") +
scale_fill_viridis_c(name = "Count", option = "C") + # could look at better colours range
scale_x_continuous("IMDb rating (rounded)", breaks = 1:10) +
scale_y_continuous("My rating", breaks = 2:10, limits = c(1, 11)) +
facet_wrap(~genre) +
labs(title = "Heatmap of My Ratings vs IMDb Rating") +
theme(legend.position = "right")
