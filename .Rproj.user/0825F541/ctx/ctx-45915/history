# Heatmap function
build_heatmap_data <- function() {
Year_Stats %>%
select(year, no_of_films, ave_rat, my_se, ave_irat, pub_se) %>%
inner_join(
Film_Nos %>% select(year, IMDb_Studio_Films),
by = "year"
) %>%
mutate(My_Ratio = no_of_films / IMDb_Studio_Films)
}
prior_strength <- 5# tweakable
A <- Year_Stats %>%
filter(no_of_films > 5) %>%
mutate(
shrink_weight = no_of_films / (no_of_films + prior_strength),
shrunk_mean = shrink_weight * ave_rat +
(1 - shrink_weight) * Total_Stats$my_ave
) %>%
inner_join(
Film_Nos %>% select(year, IMDb_Studio_Films),
by = "year"
) %>%
mutate(My_Ratio = no_of_films / IMDb_Studio_Films)
lambda <- 0.7  # tweak this
A <- A %>%
mutate(
selection_penalty = lambda * My_Ratio,
uncertainty_penalty = 1.96 * my_se,
final_score = shrunk_mean - uncertainty_penalty - selection_penalty
)
ggplot(A, aes(x = year, y = shrunk_mean)) +
geom_point(aes(size = n, color = coverage), alpha = 0.8) +
geom_line(aes(y = final_score), linetype = "dashed") +
scale_color_viridis_c(labels = percent_format()) +
labs(
title = "Film Ratings by Year (Adjusted for Bias & Uncertainty)",
x = "Year",
y = "Rating",
size = "Films Watched",
color = "Coverage"
) +
theme_minimal()
library(scales)
ggplot(A, aes(x = year, y = shrunk_mean)) +
geom_point(aes(size = n, color = coverage), alpha = 0.8) +
geom_line(aes(y = final_score), linetype = "dashed") +
scale_color_viridis_c(labels = percent_format()) +
labs(
title = "Film Ratings by Year (Adjusted for Bias & Uncertainty)",
x = "Year",
y = "Rating",
size = "Films Watched",
color = "Coverage"
) +
theme_minimal()
ggplot(A, aes(x = year, y = shrunk_mean)) +
geom_point(aes(size = n, color = My_Ratio), alpha = 0.8) +
geom_line(aes(y = final_score), linetype = "dashed") +
scale_color_viridis_c(labels = percent_format()) +
labs(
title = "Film Ratings by Year (Adjusted for Bias & Uncertainty)",
x = "Year",
y = "Rating",
size = "Films Watched",
color = "Coverage"
) +
theme_minimal()
ggplot(A, aes(x = year, y = shrunk_mean)) +
geom_point(aes(size = no_of_films, color = My_Ratio), alpha = 0.8) +
geom_line(aes(y = final_score), linetype = "dashed") +
scale_color_viridis_c(labels = percent_format()) +
labs(
title = "Film Ratings by Year (Adjusted for Bias & Uncertainty)",
x = "Year",
y = "Rating",
size = "Films Watched",
color = "Coverage"
) +
theme_minimal()
Year_Stats <- Tidy_Ratings  %>%
group_by(year) %>%
summarise("no_of_films" = n(),
"ave_rat" = mean(your_rating),
"my_sd_rat" = sd(your_rating),
"my_se" = my_sd_rat / sqrt(no_of_films),
"ave_irat" = mean(IMDb_Rating),
"pub_sd_rat" = sd(IMDb_Rating),
"pub_se" = pub_sd_rat / sqrt(no_of_films),
"ave_runtime" = mean(runtime_mins),
"ave_dif" = round(mean(rate_dif), 2),
"dif_sd_rat" = sd(IMDb_Rating),
"dif_se" = pub_sd_rat / sqrt(no_of_films),
"ave_votes" = mean(num_votes))
Total_Stats <- list(
my_ave = mean(Tidy_Ratings$your_rating),
pub_ave = mean(Tidy_Ratings$IMDb_Rating, na.rm = T),
dif_ave = mean(Tidy_Ratings$rate_dif, na.rm = T),
dif_lowerq = quantile(Tidy_Ratings$rate_dif, probs = c(0.025)),
dif_upperq = quantile(Tidy_Ratings$rate_dif, probs = c(0.975))
)
View(Total_Stats)
