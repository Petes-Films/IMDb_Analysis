Min_Film_Years <- 5
Year_Stats_Bonus <- Tidy_Ratings  %>%
group_by(year) %>%
filter(n() >= Min_Film_Years) %>%
summarise("no_of_films" = n(),
"ave_rat" = mean(your_rating),
"ave_irat" = mean(IMDb_Rating),
"combo_ave" = (ave_rat + ave_irat) / 2,
"ave_runtime" = mean(runtime_mins),
"ave_dif" = round(mean(rate_dif), 2),
"ave_votes" = mean(num_votes),
"per_like_more" = round(100 * (sum(LikeMore) / n()), 1))
A <- Year_Stats %>%
filter(no_of_films > 4) %>%
mutate(
shrink_weight = no_of_films / (no_of_films + prior_strength),
shrunk_mean = shrink_weight * ave_rat +
(1 - shrink_weight) * Total_Stats$my_ave
) %>%
inner_join(
Film_Nos %>% select(year, IMDb_Studio_Films),
by = "year"
) %>%
mutate(My_Ratio = no_of_films / IMDb_Studio_Films)
View(A)
lambda <- 0.7  # tweak this
A <- A %>%
mutate(
selection_penalty = lambda * My_Ratio
)
View(A)
A <- Year_Stats %>%
filter(no_of_films > 4) %>%
mutate(
shrink_weight = no_of_films / (no_of_films + prior_strength),
shrunk_mean = shrink_weight * ave_rat +
(1 - shrink_weight) * Total_Stats$my_ave
) %>%
inner_join(
Film_Nos %>% select(year, IMDb_Studio_Films),
by = "year"
) %>%
mutate(My_Ratio = no_of_films / IMDb_Studio_Films,
uncertainty_penalty = 1.96 * my_se,
final_score = shrunk_mean - uncertainty_penalty - selection_penalty)
