Year_Stats <- Tidy_Ratings  %>%
group_by(year) %>%
summarise("no_of_films" = n(),
"ave_rat" = mean(your_rating),
"my_sd_rat" = sd(your_rating),
"my_se" = my_sd_rat / sqrt(n),
"ave_irat" = mean(IMDb_Rating),
"pub_sd_rat" = sd(IMDb_Rating),
"pub_se" = pub_sd_rat / sqrt(n),
"ave_runtime" = mean(runtime_mins),
"ave_dif" = round(mean(rate_dif), 2),
"ave_votes" = mean(num_votes))
Year_Stats <- Tidy_Ratings  %>%
group_by(year) %>%
summarise("no_of_films" = n(),
"ave_rat" = mean(your_rating),
"my_sd_rat" = sd(your_rating),
"my_se" = my_sd_rat / sqrt(no_of_films),
"ave_irat" = mean(IMDb_Rating),
"pub_sd_rat" = sd(IMDb_Rating),
"pub_se" = pub_sd_rat / sqrt(no_of_films),
"ave_runtime" = mean(runtime_mins),
"ave_dif" = round(mean(rate_dif), 2),
"ave_votes" = mean(num_votes))
View(Year_Stats)
Total_Stats <- list(
my_ave = mean(Tidy_Ratings$your_rating),
pub_ave = mean(Tidy_Ratings$IMDb_Rating, na.rm = T),
dif_lowerq = quantile(Tidy_Ratings$rate_dif, probs = c(0.025)),
dif_upperq = quantile(Tidy_Ratings$rate_dif, probs = c(0.975))
)
prior_strength <- 20  # tweakable
A <- Year_Stats %>%
mutate(
shrink_weight = n / (n + prior_strength),
shrunk_mean = shrink_weight * ave_rat +
(1 - shrink_weight) * Total_Stats$my_ave
)
A <- Year_Stats %>%
mutate(
shrink_weight = no_of_films / (no_of_films + prior_strength),
shrunk_mean = shrink_weight * ave_rat +
(1 - shrink_weight) * Total_Stats$my_ave
)
View(A)
